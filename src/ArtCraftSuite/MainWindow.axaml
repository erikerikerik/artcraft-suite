<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ArtCraftSuite.ViewModels"
        x:Class="ArtCraftSuite.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ArtCraft Suite" Width="1040" Height="720" MinWidth="880" MinHeight="600"
        Background="#0D0F16">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="#12141E" Padding="28,22" BorderBrush="#292C3A" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="ARTCRAFT SUITE" FontSize="13" FontWeight="Bold" Foreground="#A998FF" LetterSpacing="2" />
          <TextBlock Text="Your creative toolkit, in one place." FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" />
          <TextBlock Text="Official upstream builds · verified before install" Foreground="#9CA3B4" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
          <TextBlock Text="Channel" VerticalAlignment="Center" Foreground="#AAB0C0" />
          <ComboBox Width="120" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" IsEnabled="{Binding !IsBusy}" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="23,12" RowDefinitions="Auto,*">
        <TextBlock Text="APPLICATIONS" FontSize="12" FontWeight="Bold" Foreground="#72798D" LetterSpacing="1.5" Margin="5,0,0,5" />
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Apps}" Margin="0,0,0,24">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AppItemViewModel">
              <Border Classes="card" Margin="5" Background="{Binding CardBackground}" BorderBrush="{Binding CardBorder}" ToolTip.Tip="{Binding Error}">
                <Grid ColumnDefinitions="Auto,54,*" RowDefinitions="Auto,Auto,Auto">
                  <CheckBox Grid.Column="0" Grid.RowSpan="3" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <Border Grid.Column="1" Grid.RowSpan="3" Width="44" Height="44" CornerRadius="10" Background="{Binding Accent}" VerticalAlignment="Center" ClipToBounds="True">
                    <Image Source="{Binding Icon}" Width="44" Height="44" Stretch="UniformToFill" />
                  </Border>
                  <Grid Grid.Column="2" Margin="8,0,0,0" ColumnDefinitions="*,Auto">
                    <StackPanel Margin="0,0,10,0">
                      <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" Foreground="#979EAF" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding VersionSummary}" Foreground="#7F8799" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ReleaseLabel}" HorizontalAlignment="Right" Foreground="#A998FF" FontSize="12" />
                  </Grid>
                  <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="8,7,0,0">
                    <Border Background="#242738" CornerRadius="10" Padding="8,3">
                      <TextBlock Text="{Binding StateLabel}" FontSize="10" FontWeight="Bold" Foreground="#D8DCE8" />
                    </Border>
                    <Border Background="#164B38" BorderBrush="#39C98A" BorderThickness="1" CornerRadius="10" Padding="8,3" IsVisible="{Binding HasRelease}">
                      <TextBlock Text="{Binding VerificationLabel}" FontSize="10" FontWeight="Bold" Foreground="#83F0BE" />
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Grid.Row="2" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right" Margin="8,8,0,0">
                    <Button Classes="open" Content="Open" Command="{Binding OpenCommand}" IsVisible="{Binding IsInstalled}" />
                    <Button Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding IsInstalled}" />
                    <Button Classes="primary" Content="{Binding ActionLabel}" Command="{Binding InstallCommand}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="#12141E" Padding="28,16" BorderBrush="#292C3A" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Column="0" Margin="0,0,20,0">
          <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="4" Margin="0,9,0,0" IsVisible="{Binding IsBusy}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" />
          <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
          <Button Classes="primary" Content="Install selected" Command="{Binding InstallSelectedCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
